            private async Task PaginaAnterior()
            {
                if (PaginaActual > 1)
                {
                    PaginaActual--;
                    await Buscar(false);
                }
            }

            private async Task PaginaSiguiente()
            {
                if (PaginaActual < TotalPaginas)
                {
                    PaginaActual++;
                    await Buscar(false);
                }
            }

            private string ObtenerDepartamentoCompleto(string? codigo)
            {
