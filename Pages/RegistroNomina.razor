                                DG03 = x.Dg03hh,
                                DG04 = x.Dg04hh,
                                DG05 = x.Dg05hh,
                                DG06 = x.Dg06hh,
                                DG07 = x.Dg07hh
                            })
                                .ToList();

                            TotalRegistros = registrosTotal.Count;

                        TotalRegistros = historicosDiaria.Count;

                        break;

                    case "RegistroNomina":

                        var responseNomina =
                            await ApiService.GetRegistrosNomina(
                                anioSeleccionado,
                                periodoSeleccionado,
                                fichaSeleccionada,
                                CodigoDepto);

                        registrosNomina = responseNomina.Data;

                        TotalRegistros = responseNomina.TotalRegistros;
                        TotalPaginas = responseNomina.TotalPaginas;

                        registrosTotal = registrosNomina
                            .Select(x => new RegistroNominaVistaDTO
                            {
                                Ciahnh = x.Ciahnh,
                                Tpnhnh = x.Tpnhnh,
                                TipoNomina = x.Tpnom == "M" ? "MENSUAL" : "DIARIA",

                                Ficha = x.Fichnh,
                                Nombre = ObtenerNombreCompleto(x.Fichnh),
                                Departamento = ObtenerDepartamentoCompleto(x.Dpthnh),

                                Año = x.Añohnh,
                                Periodo = x.Prdhnh,

                                DG01 = x.Dg01hh,
                                DG02 = x.Dg02hh,
                                DG03 = x.Dg03hh,
                                DG04 = x.Dg04hh,
                                DG05 = x.Dg05hh,
                                DG06 = x.Dg06hh,
                                DG07 = x.Dg07hh,
                                DG08 = x.Dg08hh ?? string.Empty,
                                DG09 = x.Dg09hh ?? string.Empty,
                                DG10 = x.Dg010hh ?? string.Empty,
                                DG11 = x.Dg011hh ?? string.Empty,
                                DG12 = x.Dg012hh ?? string.Empty,
                                DG13 = x.Dg013hh ?? string.Empty,
                                DG14 = x.Dg014hh ?? string.Empty,
                                DG15 = x.Dg015hh ?? string.Empty,
                                Stareg = x.Stareg
                            })
                            .ToList();

                        TotalRegistros = registrosTotal.Count;

                        break;
                }

                busquedaRealizada = true;
            }
            finally
            {
                cargando = false;

                await InvokeAsync(StateHasChanged);
            }        
        }

