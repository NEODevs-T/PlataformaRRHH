        private async Task Buscar(bool reiniciarPagina = true)
        {
            if (reiniciarPagina)
                PaginaActual = 1;

            cargando = true;

            registrosTotal.Clear();
            historicosMensual.Clear();
            historicosDiaria.Clear();
            registrosNomina.Clear();

            TotalRegistros = 0;
            TotalPaginas = 0;

            try
            {
                if (origenSeleccionado == "Diaria")
                {
                    if (anioSeleccionado == null || periodoSeleccionado == null)
                    {
                        await JS.InvokeVoidAsync(
                            "alert",
                            "Debe indicar Año y Período.");

                        return;
                    }
                }

                switch (origenSeleccionado)
                {
                    case "Todos":

                        registrosTotal = new();

                        var responseMensualTodos =
                            await ApiService.GetRotacionHistorico(
                                anioSeleccionado ?? DateTime.Now.Year,
                                fichaSeleccionada,
                                CodigoDepto,
                                periodoSeleccionado,
                                1,
                                500);

                        historicosMensual =
                            responseMensualTodos.Data ?? new();

                        var responseDiariaTodos =
                            await ApiService.GetPermisosNomDiariaV(
                                anioSeleccionado ?? DateTime.Now.Year,
                                periodoSeleccionado ?? 1,
                                fichaSeleccionada,
                                CodigoDepto);

                        historicosDiaria =
                            responseDiariaTodos.Data ?? new();

                        registrosTotal.AddRange(
                            historicosMensual.Select(x => new RegistroNominaVistaDTO
                            {
                                TipoNomina = "MENSUAL",
                                Ciahnh = x.Ciahnh,
                                Tpnhnh = x.Tpnhnh,
                                Ficha = x.Fichnh,
                                Nombre = ObtenerNombreCompleto(x.Fichnh),
                                Departamento = ObtenerDepartamentoCompleto(x.Dpthnh),
                                Año = Convert.ToInt32(x.Añohnh),
                                Periodo = Convert.ToInt32(x.Prdhnh),

                                DG01 = x.Dg01hh,
                                DG02 = x.Dg02hh,
                                DG03 = x.Dg03hh,
                                DG04 = x.Dg04hh,
                                DG05 = x.Dg05hh,
                                DG06 = x.Dg06hh,
                                DG07 = x.Dg07hh,
                                DG08 = x.Dg08hh,
                                DG09 = x.Dg09hh,
                                DG10 = x.Dg10hh,
                                DG11 = x.Dg11hh,
                                DG12 = x.Dg12hh,
                                DG13 = x.Dg13hh,
                                DG14 = x.Dg14hh,
                                DG15 = x.Dg15hh
                            }));

                        registrosTotal.AddRange(
                            historicosDiaria.Select(x => new RegistroNominaVistaDTO
                            {
                                TipoNomina = "DIARIA",
                                Ciahnh = x.Ciahnh,
                                Tpnhnh = x.Tpnhnh,
                                Ficha = x.Fichnh,
                                Nombre = ObtenerNombreCompleto(x.Fichnh),
                                Departamento = ObtenerDepartamentoCompleto(x.Dpthnh),
                                Año = Convert.ToInt32(x.Añohnh),
                                Periodo = Convert.ToInt32(x.Prdhnh),

                                DG01 = x.Dg01hh,
                                DG02 = x.Dg02hh,
                                DG03 = x.Dg03hh,
                                DG04 = x.Dg04hh,
                                DG05 = x.Dg05hh,
                                DG06 = x.Dg06hh,
                                DG07 = x.Dg07hh
                            }));

                            TotalRegistros = registrosTotal.Count;

                        break;

                    case "Mensual":

                        var responseMensual =
                            await ApiService.GetRotacionHistorico(
                                anioSeleccionado ?? DateTime.Now.Year,
                                fichaSeleccionada,
                                CodigoDepto,
                                periodoSeleccionado,
                                PaginaActual,
                                RegistrosPorPagina);

                        historicosMensual =
                            responseMensual.Data ?? new List<VRotacionHistDTO>();

                        registrosTotal = historicosMensual
                            .Select(x => new RegistroNominaVistaDTO
                            {
                                Ciahnh = x.Ciahnh,
                                Tpnhnh = x.Tpnhnh,

                                TipoNomina = "MENSUAL",
                                Ficha = x.Fichnh,
