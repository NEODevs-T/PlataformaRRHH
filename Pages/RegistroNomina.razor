            private string ObtenerNombreCompleto(string? ficha)
            {
                ficha = (ficha ?? "").Trim();

                var activo = TrabajadoresActivos.FirstOrDefault(x =>
                    (x.Codfic ?? "").Trim() == ficha);

                if (activo != null)
                {
                    return
                        $"{activo.Nomfi1} {activo.Nomfi2} {activo.Apefi1} {activo.Apefi2}"
                            .Replace("  ", " ")
                            .Trim();
                }

                var retirado = TrabajadoresRetirados.FirstOrDefault(x =>
                    (x.Codfic ?? "").Trim() == ficha);

                if (retirado != null)
                {
                    return
                        $"{retirado.Nomfi1} {retirado.Nomfi2} {retirado.Apefi1} {retirado.Apefi2}"
                            .Replace("  ", " ")
                            .Trim();
                }

                return "";
            }

            private async Task GuardarRegistro()
            {
                if (registroSeleccionado == null)
                return;

                var dto = new RegistNominaCreateDTO
                {
                    Ciahnh = registroSeleccionado.Ciahnh,
                    Tpnhnh = registroSeleccionado.Tpnhnh,
                    Añohnh = registroSeleccionado.Añohnh,
                    Prdhnh = registroSeleccionado.Prdhnh,
                    Fichnh = registroSeleccionado.Fichnh,
                    Dpthnh = registroSeleccionado.Dpthnh?
                                    .Split('-')
                                    .FirstOrDefault()?
                                    .Trim()
                                    ?? string.Empty,
                    Dg01hh = registroSeleccionado.Dg01hh,
                    Dg02hh = registroSeleccionado.Dg02hh,
                    Dg03hh = registroSeleccionado.Dg03hh,
                    Dg04hh = registroSeleccionado.Dg04hh,
                    Dg05hh = registroSeleccionado.Dg05hh,
                    Dg06hh = registroSeleccionado.Dg06hh,
                    Dg07hh = registroSeleccionado.Dg07hh,
                    Dg08hh = registroSeleccionado.Dg08hh,
                    Dg09hh = registroSeleccionado.Dg09hh,
                    Dg010hh = registroSeleccionado.Dg010hh,
                    Dg011hh = registroSeleccionado.Dg011hh,
                    Dg012hh = registroSeleccionado.Dg012hh,
                    Dg013hh = registroSeleccionado.Dg013hh,
                    Dg014hh = registroSeleccionado.Dg014hh,
                    Dg015hh = registroSeleccionado.Dg015hh,

                    Tpnom = registroSeleccionado.Tpnom,
                    Stareg = registroSeleccionado.Stareg
                };

                if (registroSeleccionado == null)
                    return;

                if (registroSeleccionado.Añohnh <= 0)
                {
                    await JS.InvokeVoidAsync(
                        "alert",
                        "Debe indicar un año válido.");
                    return;
                }

                if (registroSeleccionado.Prdhnh <= 0)
                {
                    await JS.InvokeVoidAsync(
                        "alert",
                        "Debe indicar un período válido.");
                    return;
                }

                if (string.IsNullOrWhiteSpace(
                        registroSeleccionado.Fichnh))
                {
                    await JS.InvokeVoidAsync(
                        "alert",
                        "Debe indicar una ficha.");
                    return;
                }

                if (string.IsNullOrWhiteSpace(
                        registroSeleccionado.Dpthnh))
                {
                    await JS.InvokeVoidAsync(
                        "alert",
                        "Debe indicar un departamento.");
                    return;
                }

                try
                {
                    bool resultado;

                    if (origenSeleccionado == "RegistroNomina")
                    {
                        resultado = await ApiService.CambiarEstadoRegistroNomina(
                            dto.Fichnh,
                            dto.Añohnh,
                            dto.Prdhnh,
                            dto.Tpnom,
                            dto.Stareg);
                    }
                    else
                    {
                        resultado = await ApiService.CreateRegistroNomina(dto);
                    }

                    if (!resultado)
                    {
                        await JS.InvokeVoidAsync(
                            "alert",
                            "No se pudo guardar el registro.");

                        return;
                    }

                    await JS.InvokeVoidAsync(
                        "alert",
                        "Registro guardado correctamente.");
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex);

                    await JS.InvokeVoidAsync(
                        "alert",
                        ex.Message);
                }

                mostrarModal = false;

                await Buscar();
            }

            protected override async Task OnInitializedAsync()
