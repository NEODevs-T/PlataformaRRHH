                        <div class="table-responsive">
                            <table class="table-custom">

                                <thead>

                                <tr>

                                    <th style="width:90px;">Ficha</th>
                                    <th style="width:220px;">Nombre</th>
                                    <th style="width:260px;">Departamento</th>
                                    <th style="width:120px;">Tipo</th>
                                    <th style="width:90px;">Año</th>
                                    <th style="width:90px;">Periodo</th>
                                    <th style="width:320px;">Esquema</th>
                                    <th style="width:140px;"></th>

                                </tr>

                                </thead>

                                <tbody>

                                @foreach (var item in RegistrosFiltrados)
                                {
                                    <tr>

                                        <td>@item.Ficha</td>
                                        <td class="nombre-cell">@item.Nombre</td>
                                        <td>@item.Departamento</td>

                                        <td>@item.TipoNomina</td>

                                        <td>@item.Año</td>

                                        <td>@item.Periodo</td>

                                        <td class="esquema-cell">
                                            <span>@item.DG01</span>
                                            <span>@item.DG02</span>
                                            <span>@item.DG03</span>
                                            <span>@item.DG04</span>
                                            <span>@item.DG05</span>
                                            <span>@item.DG06</span>
                                            <span>@item.DG07</span>
                                            <span>@item.DG08</span>
                                            <span>@item.DG09</span>
                                            <span>@item.DG10</span>
                                            <span>@item.DG11</span>
                                            <span>@item.DG12</span>
                                            <span>@item.DG13</span>
                                            <span>@item.DG14</span>
                                            <span>@item.DG15</span>
                                        </td>

                                            <td class="text-center align-middle">
                                            @if (origenSeleccionado == "RegistroNomina")
                                            {
                                                <button class="btn btn-info btn-sm accion-btn"
                                                        @onclick="() => VerRegistro(item)">
                                                    👁 Ver
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-success btn-sm accion-btn"
                                                        @onclick="() => VerRegistro(item)">
                                                    ✏ Modificar
                                                </button>
                                            }
                                        </td>

                                    </tr>
                                }

                                </tbody>

                                </table>

                            </div>
                            }

                            @if (TotalPaginas > 1)
                            {
                                <div class="d-flex justify-content-between align-items-center mt-3">

                                    <button class="btn btn-outline-secondary"
                                            @onclick="PaginaAnterior"
                                            disabled="@(PaginaActual == 1)">
                                        ← Anterior
                                    </button>

                                    <span>
                                        Página @PaginaActual de @TotalPaginas
