    @if (cargando)
    {
        <div class="loading-container">

            <div class="loading-spinner"></div>

            <div class="loading-text">
                Cargando información del registro de nómina...
            </div>

        </div>
    }
    else
    {
            <div class="dashboard-header">

                <div class="header-icon">
                    <i class="oi oi-task"></i>
                </div>

                <span>
                    REGISTRO DE NÓMINA
                </span>

            </div>

            <p class="page-subtitle">
                Consulta y administración de registros de nómina.
            </p>

            <div class="filtros">

                <div class="filtro-item">
                    <label>Ficha</label>
                    <input class="input"
                        @bind="fichaSeleccionada" />
                </div>

                <div class="filtro-item">
                    <label>Departamento</label>
                    <InputSelect class="input"
                                @bind-Value="departamentoSeleccionado">
                        <option value="">TODOS</option>
                        @foreach (var dep in DepartamentosDisponibles)
                        {
                            <option value="@dep">@dep</option>
                        }
                    </InputSelect>
                </div>

                <div class="filtro-item">
                    <label>Año</label>
                    <InputSelect class="input"
                                @bind-Value="anioSeleccionado">
                        @foreach (var anio in AniosDisponibles)
                        {
                            <option value="@anio">@anio</option>
                        }
                    </InputSelect>
                </div>

                <div class="filtro-item">
                    <label>Período</label>
                    <InputSelect class="input"
                                @bind-Value="periodoSeleccionado">
                        @foreach (var periodo in PeriodosDisponibles)
                        {
                            <option value="@periodo">@periodo</option>
                        }
                    </InputSelect>
                </div>

                <div class="filtro-item">
                    <label>Origen</label>
                    <InputSelect class="input"
                                @bind-Value="origenSeleccionado">
                        <option value="Todos">Registro Total</option>
                        <option value="Mensual">Registro Mensual</option>
                        <option value="Diaria">Registro Diario</option>
                        <option value="RegistroNomina">Registro Nómina</option>
                    </InputSelect>
                </div>

                <div class="filtro-item acciones-filtro">
                    <label>&nbsp;</label>
                    <button class="btn-filtrar"
                            @onclick="async () => await Buscar()">
                        Consultar
                    </button>
                </div>

