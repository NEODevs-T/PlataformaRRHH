                                DG04 = x.Dg04hh,
                                DG05 = x.Dg05hh,
                                DG06 = x.Dg06hh,
                                DG07 = x.Dg07hh,
                                DG08 = x.Dg08hh,
                                DG09 = x.Dg09hh,
                                DG10 = x.Dg10hh,
                                DG11 = x.Dg11hh,
