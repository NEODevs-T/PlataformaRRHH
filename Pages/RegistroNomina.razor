    @code {
            private int TotalRegistros = 0;
            
            private bool SoloEstado;
            
            private int TotalPaginas = 0;

            private int? anioSeleccionado = DateTime.Now.Year;

            private int? periodoSeleccionado = 1;

            private string? departamentoSeleccionado = "";

            private string? fichaSeleccionada = "";
            //private string? tipoNominaSeleccionado;
            private string origenSeleccionado = "Todos";
            private bool cargando = true;

            private int PaginaActual = 1;
            private int RegistrosPorPagina = 500;

            private List<VRotacionHistDTO> historicosMensual = new();

            private List<PermisosNomDiariaVDTO> historicosDiaria = new();

            private List<RegistNominaDTO> registrosNomina = new();

            private bool mostrarModal = false;

            private RegistNominaCreateDTO? registroSeleccionado;

            private bool busquedaRealizada = false;

            private bool soloLectura;

            private List<string> DepartamentosDisponibles = new();

            private List<MaestroTrabajadorDTO> TrabajadoresActivos = new();

            private List<MaestroTrabajadorReDTO> TrabajadoresRetirados = new();

            private List<RegistroNominaVistaDTO> registrosTotal = new();

            private string filtroTabla = "";

            private string? CodigoDepto =>
                departamentoSeleccionado?
                    .Split('-')
                    .FirstOrDefault()?
                    .Trim();

            private IEnumerable<VRotacionHistDTO> HistoricosMensualPaginados =>
                historicosMensual
                    .Skip((PaginaActual - 1) * RegistrosPorPagina)
                    .Take(RegistrosPorPagina);

            private IEnumerable<RegistNominaDTO> RegistrosNominaPaginados =>
                registrosNomina
                    .Skip((PaginaActual - 1) * RegistrosPorPagina)
                    .Take(RegistrosPorPagina);

            private void EditarRegistro(RegistNominaDTO registro)
