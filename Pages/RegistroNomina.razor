                    <button class="btn-danger"
                            @onclick="ExportarPdf">
                        Exportar PDF
                    </button>
                </div>

            </div>

            @if (cargando)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-success"></div>

                    <div class="mt-3">
                        Consultando información...
                    </div>
                </div>
            }
