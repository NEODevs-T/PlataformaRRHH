                        ?? new();

                    DepartamentosDisponibles = Departamentos
                        .OrderBy(x => x.Value)
                        .Select(x => $"{x.Key} - {x.Value}")
                        .ToList();
                }
                finally
                {
                    cargando = false;
                }
            }

