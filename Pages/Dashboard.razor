        async Task ExportarPdf()
        {
            var document = new PdfDocument();

            var page = document.AddPage();

            page.Width = 842;
            page.Height = 595;

            var gfx =
                XGraphics.FromPdfPage(page);

            var titulo =
                new XFont("Arial", 22, XFontStyle.Bold);

            var subtitulo =
                new XFont("Arial", 12, XFontStyle.Bold);

            var texto =
                new XFont("Arial", 10, XFontStyle.Regular);

            int y = 40;

            gfx.DrawString(
                "Dashboard Ausentismo",
                titulo,
                XBrushes.DarkGreen,
                new XRect(0, y, page.Width, 30),
                XStringFormats.TopCenter);

            y += 50;

            gfx.DrawString(
                $"Año: {anioIndicadores}",
                subtitulo,
                XBrushes.Black,
                40,
                y);

            y += 35;

            //=========================
            // RESUMEN GENERAL
            //=========================

            gfx.DrawString(
                "Resumen General",
                subtitulo,
                XBrushes.DarkGreen,
                40,
                y);

            y += 20;

            int x = 40;

            string[] headers =
            {
                "Permisos",
                "Faltas",
                "Reposos",
                "Horas Aus.",
                "Horas Prog.",
                "Indice %"
            };

            string[] valores =
            {
                totalPermisos.ToString(),
                totalFaltas.ToString(),
                totalReposos.ToString(),
                eventosAusentismo.ToString(),
                horasProgramadas.ToString(),
                indiceAusentismo.ToString("0.00")
            };

            for(int i = 0; i < headers.Length; i++)
            {
                gfx.DrawRectangle(
                    XPens.Black,
                    XBrushes.DarkGreen,
                    x,
                    y,
                    110,
                    25);

                gfx.DrawString(
                    headers[i],
                    texto,
                    XBrushes.White,
                    new XRect(x, y, 110, 25),
                    XStringFormats.Center);

                x += 110;
            }

            y += 25;

            x = 40;

            for(int i = 0; i < valores.Length; i++)
            {
                gfx.DrawRectangle(
                    XPens.Black,
                    XBrushes.White,
                    x,
                    y,
                    110,
                    25);

                gfx.DrawString(
                    valores[i],
                    texto,
                    XBrushes.Black,
                    new XRect(x, y, 110, 25),
                    XStringFormats.Center);

                x += 110;
            }

            y += 50;

            //=========================
            // DETALLE POR MES
            //=========================

            gfx.DrawString(
                "Detalle por Mes",
                subtitulo,
                XBrushes.DarkGreen,
                40,
                y);

            y += 20;

            string[] columnas =
            {
                "Mes",
                "Permisos",
                "Faltas",
                "Reposos",
                "Indice %"
            };

            int[] anchos =
            {
                160,
                90,
                90,
                90,
                110
            };

            x = 40;

            for(int i = 0; i < columnas.Length; i++)
            {
                gfx.DrawRectangle(
                    XPens.Black,
                    XBrushes.DarkGreen,
                    x,
                    y,
                    anchos[i],
                    25);

                gfx.DrawString(
                    columnas[i],
                    texto,
                    XBrushes.White,
                    new XRect(x, y, anchos[i], 25),
                    XStringFormats.Center);

                x += anchos[i];
            }

            y += 25;

            foreach(var r in detalleMeses)
            {
                x = 40;

                string[] fila =
                {
                    $"{r.NombreMes} {r.Anio}",
                    r.Permisos.ToString(),
                    r.Faltas.ToString(),
                    r.Reposos.ToString(),
                    r.Indice.ToString("0.00")
                };

                for(int i = 0; i < fila.Length; i++)
                {
                    gfx.DrawRectangle(
                        XPens.Black,
                        x,
                        y,
                        anchos[i],
                        22);

                    gfx.DrawString(
                        fila[i],
                        texto,
                        XBrushes.Black,
                        new XRect(x, y, anchos[i], 22),
                        XStringFormats.Center);

                    x += anchos[i];
                }

                y += 22;

                if(y > page.Height - 40)
                    break;
            }

            using var stream = new MemoryStream();

            document.Save(stream);

            var archivo =
                Convert.ToBase64String(
                    stream.ToArray());

            await JS.InvokeVoidAsync(
                "downloadFile",
                "DashboardAusentismo.pdf",
                archivo);
        }

