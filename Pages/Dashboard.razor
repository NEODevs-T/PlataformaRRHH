            int ObtenerMesDesdePeriodo(int periodo)
            {
                if (periodo < 1 || periodo > 24)
                    return 0;

                return ((periodo - 1) / 2) + 1;
            }

            int ObtenerQuincenaDesdeSemana(int semana)
            {
                return semana switch
                {
                    1 or 2 => 1,
                    3 or 4 => 2,

                    5 or 6 => 3,
                    7 or 8 => 4,

                    9 or 10 => 5,
                    11 or 12 => 6,

                    13 or 14 => 7,
                    15 or 16 => 8,

                    17 or 18 => 9,
                    19 or 20 => 10,

                    21 or 22 => 11,
                    23 or 24 => 12,

                    25 or 26 => 13,
                    27 or 28 => 14,

                    29 or 30 => 15,
                    31 or 32 => 16,

                    33 or 34 => 17,
                    35 or 36 => 18,

                    37 or 38 => 19,
                    39 or 40 => 20,

                    41 or 42 => 21,
                    43 or 44 => 22,

                    45 or 46 => 23,
                    47 or 48 => 24,

                    49 or 50 => 23,
                    51 or 52 or 53 => 24,

                    _ => 0
                };
            }

            int ObtenerPermisos(
                int anio,
                int? periodoDesde = null,
                int? periodoHasta = null)
            {
                var diaria =
                    nomina.Where(x =>
                        (int)x.Añohnh == anio);

                var mensual =
                    nominaMensual.Where(x =>
                        (int)x.Añohnh == anio);

                if (
                    periodoDesde.HasValue &&
                    periodoHasta.HasValue)
                {
                    diaria = diaria.Where(x =>
                        ObtenerQuincenaDesdeSemana(
                            (int)x.Prdhnh) >= periodoDesde &&
                        ObtenerQuincenaDesdeSemana(
                            (int)x.Prdhnh) <= periodoHasta);

                    mensual = mensual.Where(x =>
                        (int)x.Prdhnh >= periodoDesde &&
                        (int)x.Prdhnh <= periodoHasta);
                }

                int permisosDiaria =
                    ContarCodigo(diaria, "P");

                int permisosMensual =
                    ContarCodigoMensual(
                        mensual,
                        "P");

                return tipoNominaIndicadores switch
                {
                    "Diaria" => permisosDiaria,
                    "Mensual" => permisosMensual,
                    _ => permisosDiaria + permisosMensual
                };
            }

            int ObtenerFaltas(
                int anio,
                int? periodoDesde = null,
                int? periodoHasta = null)
            {
                var diaria =
                    nomina.Where(x =>
                        (int)x.Añohnh == anio);

                var mensual =
                    nominaMensual.Where(x =>
                        (int)x.Añohnh == anio);

                if (
                periodoDesde.HasValue &&
                periodoHasta.HasValue)
                {
                    diaria = diaria.Where(x =>
                        ObtenerQuincenaDesdeSemana(
                            (int)x.Prdhnh) >= periodoDesde &&
                        ObtenerQuincenaDesdeSemana(
                            (int)x.Prdhnh) <= periodoHasta);

                    mensual = mensual.Where(x =>
                        (int)x.Prdhnh >= periodoDesde &&
                        (int)x.Prdhnh <= periodoHasta);
                }

                int faltasDiaria =
                    ContarCodigo(diaria, "F");

                int faltasMensual =
                    ContarCodigoMensual(
                        mensual,
                        "F");

                return tipoNominaIndicadores switch
                {
                    "Diaria" => faltasDiaria,
                    "Mensual" => faltasMensual,
                    _ => faltasDiaria + faltasMensual
                };
            }

