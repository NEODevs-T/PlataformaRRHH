            void GenerarComparativa()
        {
                // Si uno está en mes y el otro quedó en año,
                // obligar a ambos a trabajar por mes.
                if (mesComparativa1 > 0 &&
                    mesComparativa2 == 0)
                {
                    mesComparativa2 = mesComparativa1;
                }

                if (mesComparativa2 > 0 &&
                    mesComparativa1 == 0)
                {
                    mesComparativa1 = mesComparativa2;
                }

                int mesActual =
                    mesComparativa1;

                int anioActual =
                    anioComparativa1;

                int mesAnterior =
                    mesComparativa2;

                int anioAnterior =
                    anioComparativa2;

                int actual = 0;
                int anterior = 0;
                
            if (
                (mesComparativa1 == 0 && mesComparativa2 > 0)
                ||
                (mesComparativa2 == 0 && mesComparativa1 > 0)
            )
            {
                mesComparativa1 = 0;
                mesComparativa2 = 0;
            }
            
                    if (mesComparativa1 == 0 &&
                mesComparativa2 == 0)
            {
                if (tipoComparativa == "Reposos")
                {
                    actual =
                        repososPorAnio.GetValueOrDefault(
                            anioActual,
                            0);

                    anterior =
                        repososPorAnio.GetValueOrDefault(
                            anioAnterior,
                            0);
                }
                else if (tipoComparativa == "Permisos")
                {
                    
                    actual =
                        ObtenerPermisos(
                            anioActual);

                    anterior =
                        ObtenerPermisos(
                            anioAnterior);
                }
                else if (tipoComparativa == "Faltas")
                {
                    actual =
                        ObtenerFaltas(
                            anioActual);

                    anterior =
                        ObtenerFaltas(
                            anioAnterior);
                }
                else
                {
                    actual =
                        ObtenerPermisos(anioActual)
                        +
                        ObtenerFaltas(anioActual)
                        +
                        repososPorAnio.GetValueOrDefault(
                            anioActual,
                            0);

                    anterior =
                        ObtenerPermisos(anioAnterior)
                        +
                        ObtenerFaltas(anioAnterior)
                        +
                        repososPorAnio.GetValueOrDefault(
                            anioAnterior,
                            0);
                }

                comparativa = new ComparativaMes
                {
                    MesActualTexto = $"Año {anioActual}",
                    MesAnteriorTexto = $"Año {anioAnterior}",
                    ValorActual = actual,
                    ValorAnterior = anterior
                };

                Console.WriteLine("==== COMPARATIVA ====");
                Console.WriteLine($"Tipo: {tipoComparativa}");
                Console.WriteLine($"Actual: {mesActual}/{anioActual}");
                Console.WriteLine($"Anterior: {mesAnterior}/{anioAnterior}");
                Console.WriteLine($"ValorActual = {actual}");
                Console.WriteLine($"ValorAnterior = {anterior}");

                return;
            }

            if (tipoComparativa == "Reposos")
            {
                actual =
                repososPorMes.GetValueOrDefault(
                    (anioActual, mesActual),
                    0);

                anterior =
                    repososPorMes.GetValueOrDefault(
                        (anioAnterior, mesAnterior),
                        0);
            }
            else if (tipoComparativa == "Permisos")
            {
                var periodoActual =
                    ObtenerPeriodosMes(
                        mesActual);

                var periodoAnterior =
                    ObtenerPeriodosMes(
                        mesAnterior);

                actual =
                    ObtenerPermisos(
                        anioActual,
                        periodoActual.Desde,
                        periodoActual.Hasta);

                anterior =
                    ObtenerPermisos(
                        anioAnterior,
                        periodoAnterior.Desde,
                        periodoAnterior.Hasta);
            }
            else if (tipoComparativa == "Faltas")
            {
                var periodoActual =
                    ObtenerPeriodosMes(
                        mesActual);

                var periodoAnterior =
                    ObtenerPeriodosMes(
                        mesAnterior);

                actual =
                    ObtenerFaltas(
                        anioActual,
                        periodoActual.Desde,
                        periodoActual.Hasta);

                anterior =
                    ObtenerFaltas(
                        anioAnterior,
                        periodoAnterior.Desde,
                        periodoAnterior.Hasta);
            }
            else
            {
                var periodoActual =
                    ObtenerPeriodosMes(mesActual);

                var periodoAnterior =
                    ObtenerPeriodosMes(mesAnterior);                

                int repososActual =
                    repososPorMes.GetValueOrDefault(
                        (anioActual, mesActual),
                        0);

                int repososAnterior =
                    repososPorMes.GetValueOrDefault(
                        (anioAnterior, mesAnterior),
                        0);

                int permisosActual =
                    ObtenerPermisos(
                        anioActual,
                        periodoActual.Desde,
                        periodoActual.Hasta);

                int permisosAnterior =
                    ObtenerPermisos(
                        anioAnterior,
                        periodoAnterior.Desde,
                        periodoAnterior.Hasta);

                int faltasActual =
                    ObtenerFaltas(
                        anioActual,
                        periodoActual.Desde,
                        periodoActual.Hasta);

                int faltasAnterior =
                    ObtenerFaltas(
                        anioAnterior,
                        periodoAnterior.Desde,
                        periodoAnterior.Hasta);

                actual =
                    permisosActual +
                    faltasActual +
                    repososActual;

                anterior =
                    permisosAnterior +
                    faltasAnterior +
                    repososAnterior;                       
                }

            if (mesActual <= 0 || mesAnterior <= 0)
            {
                comparativa = new ComparativaMes
                {
                    MesActualTexto = $"Año {anioActual}",
                    MesAnteriorTexto = $"Año {anioAnterior}",
                    ValorActual = actual,
                    ValorAnterior = anterior
                };

                return;
            }

            comparativa = new ComparativaMes
            {
                MesActualTexto =
                    new DateTime(anioActual, mesActual, 1)
                    .ToString("MMMM yyyy"),

                MesAnteriorTexto =
                    new DateTime(anioAnterior, mesAnterior, 1)
                    .ToString("MMMM yyyy"),

                ValorActual = actual,
                ValorAnterior = anterior
            };
        }

            void CalcularKPIs()
        {     
            var diaria =
            nomina.Where(x =>
                (int)x.Añohnh == anioIndicadores);

            var mensual =
                nominaMensual.Where(x =>
                    (int)x.Añohnh == anioIndicadores);

                    Console.WriteLine(
                        $"REGISTROS DIARIA = {diaria.Count()}");

                    Console.WriteLine(
                        $"REGISTROS MENSUAL = {mensual.Count()}");

                    
            
            if (tipoNominaIndicadores == "Diaria")
            {
                mensual = Enumerable.Empty<VRotacionDTO>();
            }
            else if (tipoNominaIndicadores == "Mensual")
            {
                diaria = Enumerable.Empty<PermisosNomDiariaHistVDTO>();
            }

            var trabajadores =
                diaria
                    .Select(x => x.Fichnh)
                    .Union(
                        mensual.Select(x => x.Fichnh))
                    .Distinct()
                    .Count();

            if(tipoNominaIndicadores == "Diaria")
            {
                totalPermisos =
                    ContarCodigo(diaria, "P");

                totalFaltas =
                    ContarCodigo(diaria, "F");
            }
            else if(tipoNominaIndicadores == "Mensual")
            {
                totalPermisos =
                    ContarCodigoMensual(
                        mensual,
                        "P");

                totalFaltas =
                    ContarCodigoMensual(
                        mensual,
                        "F");
            }
            else
            {
                totalPermisos =
                    ContarCodigo(diaria, "P")
                    +
                    ContarCodigoMensual(
                        mensual,
                        "P");

                totalFaltas =
                    ContarCodigo(diaria, "F")
                    +
                    ContarCodigoMensual(
                        mensual,
                        "F");
            }

            totalReposos =
                repososPorAnio.GetValueOrDefault(
                    anioIndicadores,
                    0);

            eventosAusentismo =
                totalPermisos +
                totalFaltas +
                totalReposos;

            horasProgramadas =
                trabajadores * 20 * 8;

            indiceAusentismo =
                horasProgramadas > 0
                ? ((double)(totalPermisos + totalFaltas)
                    / horasProgramadas) * 100
                : 0;

                    Console.WriteLine(
                        $"AÑO={anioIndicadores}");

                    Console.WriteLine(
                        $"Permisos={totalPermisos}");

                    Console.WriteLine(
                        $"Faltas={totalFaltas}");

                    Console.WriteLine(
                        $"Reposos={totalReposos}");

            GenerarTendencia();
        }

