            void GenerarTendencia()
            {  
                // =========================
                // TODOS LOS MESES
                // =========================

                    if (mesTendencia == 0)
                {
                    tendenciaDias =
                        Enumerable.Range(
                        1,
                        anioIndicadores == DateTime.Now.Year
                            ? DateTime.Now.Month
                            : 12)
                        .Select(m =>
                        {
                            var periodo =
                                ObtenerPeriodosMes(m);

                            int permisosDiaria =
                                    ContarCodigo(
                                        nomina.Where(x =>
                                            (int)x.Añohnh == anioIndicadores &&
                                            ObtenerQuincenaDesdeSemana(
                                                (int)x.Prdhnh) >= periodo.Desde &&
                                            ObtenerQuincenaDesdeSemana(
                                                (int)x.Prdhnh) <= periodo.Hasta),
                                        "P");

                                int permisosMensual =
                                    ContarCodigoMensual(
                                        nominaMensual.Where(x =>
                                            (int)x.Añohnh == anioIndicadores &&
                                            (int)x.Prdhnh >= periodo.Desde &&
                                            (int)x.Prdhnh <= periodo.Hasta),
                                        "P");

                                int permisos =
                                    tipoNominaIndicadores switch
                                    {
                                        "Diaria" => permisosDiaria,
                                        "Mensual" => permisosMensual,
                                        _ => permisosDiaria + permisosMensual
                                    };

                                int faltasDiaria =
                                    ContarCodigo(
                                        nomina.Where(x =>
                                            (int)x.Añohnh == anioIndicadores &&
                                            ObtenerQuincenaDesdeSemana(
                                                (int)x.Prdhnh) >= periodo.Desde &&
                                            ObtenerQuincenaDesdeSemana(
                                                (int)x.Prdhnh) <= periodo.Hasta),
                                        "F");

                                int faltasMensual =
                                    ContarCodigoMensual(
                                        nominaMensual.Where(x =>
                                            (int)x.Añohnh == anioIndicadores &&
                                            (int)x.Prdhnh >= periodo.Desde &&
                                            (int)x.Prdhnh <= periodo.Hasta),
                                        "F");

                                int faltas =
                                    tipoNominaIndicadores switch
                                    {
                                        "Diaria" => faltasDiaria,
                                        "Mensual" => faltasMensual,
                                        _ => faltasDiaria + faltasMensual
                                    };

                            int repososMes =
                                repososPorMes.GetValueOrDefault(
                                    (anioIndicadores, m),
                                    0);

                            int total =
                                tipoTendencia switch
                                {
                                    "Reposos" => repososMes,

                                    "Permisos" => permisos,

                                    "Faltas" => faltas,

                                    _ => permisos +
                                        faltas +
                                        repososMes
                                };

                            return new TendenciaDia
                            {
                                Etiqueta =
                                    new DateTime(
                                        anioIndicadores,
                                        m,
                                        1)
                                    .ToString("MMM")
                                    .ToUpper(),

                                Subtitulo =
                                    new DateTime(
                                        anioIndicadores,
                                        m,
                                        1)
                                    .ToString("yyyy"),

                                Total = total
                            };
                        })
                        .ToList();
                    return;
                }

                // =========================
                // REPOSOS POR DIA
                // =========================

                if (tipoTendencia == "Reposos")
                {
                    int diasMes =
                    DateTime.DaysInMonth(
                        anioIndicadores,
                        mesTendencia);

                tendenciaDias =
                    Enumerable.Range(1, diasMes)
                    .Select(d => new TendenciaDia
                    {
                        Etiqueta = d.ToString(),
                        Subtitulo = $"{d}/{mesTendencia}",
                        Total = reposos.Count(r =>
                            r.FechaDesde.HasValue &&
                            r.FechaDesde.Value.Year == anioIndicadores &&
                            r.FechaDesde.Value.Month == mesTendencia &&
                            r.FechaDesde.Value.Day == d)
                    })
                    .ToList();
                    return;
                }

        // =========================
        // PERMISOS O TODOS POR PERIODO
        // =========================

            var periodo =
    ObtenerPeriodosMes(mesTendencia);

    tendenciaDias =
        Enumerable.Range(
            periodo.Desde,
            periodo.Hasta - periodo.Desde + 1)
        .Select(p =>
        {

            int totalPermisos =
                ObtenerPermisos(
                    anioIndicadores,
                    p,
                    p);

            int totalFaltas =
                ObtenerFaltas(
                    anioIndicadores,
                    p,
                    p);

        int total = 0;

    if (tipoTendencia == "Permisos")
    {
        total = totalPermisos;
    }
    else if (tipoTendencia == "Faltas")
    {
        total = totalFaltas;
    }
    else if (tipoTendencia == "Reposos")
    {
        total = 0;
    }
    else
    {
        int repososMes =
            repososPorMes.GetValueOrDefault(
                (anioIndicadores, mesTendencia),
                0);

        var periodoMes =
            ObtenerPeriodosMes(
                mesTendencia);

        int permisosMes =
            ObtenerPermisos(
                anioIndicadores,
                periodoMes.Desde,
                periodoMes.Hasta);


        if (permisosMes > 0)
        {
            int repososPeriodo =
                (int)Math.Round(
                    repososMes *
                    ((double)totalPermisos / permisosMes));

            total =
                totalPermisos +
                totalFaltas +
                repososPeriodo;
        }
        else
        {
            total =
                totalPermisos +
                totalFaltas;
        }
    }
            var rango =
            ObtenerRangoPeriodo(p);

        return new TendenciaDia
        {
            Etiqueta = $"P{p}",

            Subtitulo =
                $"{rango.Desde}-{rango.Hasta}",

            Total = total
        };
        })
        .ToList();
    }


