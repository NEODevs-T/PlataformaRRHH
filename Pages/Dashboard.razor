        string ObtenerAnchoComparativa(int valor)
        {
            int maximo =
                Math.Max(
                    comparativa.ValorActual,
                    comparativa.ValorAnterior);

            if (maximo == 0)
                return "0%";

            double porcentaje =
                (valor * 100.0) / maximo;

            return porcentaje.ToString(
                "0.##",
                CultureInfo.InvariantCulture)
