        string ObtenerPuntosLinea()
        {
            if (!tendenciaDias.Any())
                return "";

            int maximo =
                tendenciaDias.Max(x => x.Total);

            if (maximo <= 0)
                return "";

            double alturaGrafico = 180;
            double anchoBarra = 60;

            var puntos = new List<string>();

            for (int indice = 0;
                indice < tendenciaDias.Count;
                indice++)
            {
                var valor =
                    tendenciaDias[indice].Total;

                double x =
                    (indice * anchoBarra) +
                    (anchoBarra / 2);

                double y =
                    alturaGrafico -
                    ((double)valor / maximo
                    * alturaGrafico);

                puntos.Add($"{x},{y}");
            }

            return string.Join(" ", puntos);
        }


        string ObtenerAlturaBarra(int valor)
        {
            if (!tendenciaDias.Any())
                return "8px";

            int maximo = tendenciaDias.Max(x => x.Total);

            if (maximo <= 0)
                return "8px";

            const int alturaMaxima = 140;
            const int alturaMinima = 8;

            double altura =
                alturaMinima +
                ((valor * (alturaMaxima - alturaMinima))
                / (double)maximo);

            return $"{Math.Round(altura)}px";
        }

