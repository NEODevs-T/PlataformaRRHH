            void GenerarDetalle()
        {
            detalleMeses = new();

            var diaria =
                nomina
                .Where(x =>
                    (int)x.Añohnh == anioDetalle);

            var mensual =
                nominaMensual
                .Where(x =>
                    (int)x.Añohnh == anioDetalle);

            if (tipoNominaDetalle == "Diaria")
            {
                detalleMeses =
                    GenerarDetalleDiario(diaria);
            }
            else if (tipoNominaDetalle == "Mensual")
            {
                detalleMeses =
                    GenerarDetalleMensual(mensual);
            }
            else
            {
                detalleMeses =
                    GenerarDetalleDiario(diaria)
                    .Concat(
                        GenerarDetalleMensual(mensual))
                    .GroupBy(x => new
                    {
                        x.Anio,
                        x.Mes
                    })
                    .Select(g => new ResumenMensual
                    {
                        Anio = g.Key.Anio,
                        Mes = g.Key.Mes,

                        Permisos =
                            g.Sum(x => x.Permisos),

                        Faltas =
                            g.Sum(x => x.Faltas),

                        Reposos =
                            g.Max(x => x.Reposos),

                        eventosAusentismo =
                            g.Sum(x => x.eventosAusentismo),

                        HorasProgramadas =
                            g.Sum(x => x.HorasProgramadas),

                        Indice =
                            g.Sum(x => x.HorasProgramadas) > 0
                            ? Math.Round(
                                (
                                    (double)g.Sum(x => x.eventosAusentismo)
                                    /
                                    g.Sum(x => x.HorasProgramadas)
                                ) * 100,
                                2)
                            : 0
                    })
                    .OrderByDescending(x => x.Anio)
                    .ThenByDescending(x => x.Mes)
                    .ToList();
            }
        }

            List<ResumenMensual> GenerarDetalleDiario(
            IEnumerable<PermisosNomDiariaHistVDTO> data)
        {
            data = data.Where(x =>
                mesesSeleccionados.Contains(
                    ObtenerMesDesdePeriodo(
                        ObtenerQuincenaDesdeSemana(
                            (int)x.Prdhnh))));

            return data
                .GroupBy(x => new
                {
                    Anio = (int)x.Añohnh,
                    Mes = ObtenerMesDesdePeriodo(
                    ObtenerQuincenaDesdeSemana(
                        (int)x.Prdhnh))
                })
                .Select(g =>
                {
                    var trabajadores =
                        g.Select(x => x.Fichnh)
                        .Distinct()
                        .Count();

                    var permisos =
                        ContarCodigo(g, "P");

                    var faltas =
                        ContarCodigo(g, "F");

                    var repososMes =
                        repososPorMes.GetValueOrDefault(
                            (g.Key.Anio, g.Key.Mes),
                            0);

                    var ausencias =
                        permisos +
                        faltas +
                        repososMes;

                    return new ResumenMensual
                    {
                        Anio = g.Key.Anio,
                        Mes = g.Key.Mes,
                        Permisos = permisos,
                        Faltas = faltas,
                        Reposos = repososMes,
                        eventosAusentismo = ausencias,
                        HorasProgramadas =
                            trabajadores * 20 * 8,
                        Indice =
                            trabajadores > 0
                            ? Math.Round(
                                (double)ausencias /
                                (trabajadores * 20 * 8)
                                * 100,
                                2)
                            : 0
                    };
                })
                .ToList();
        }


