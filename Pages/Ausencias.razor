@page "/ausencias"
@inject IJSRuntime JS
@using NeoRH.DTOs
@inject IRRHHApiService Api
@using Microsoft.AspNetCore.Authorization

<link href="./css/site.css" rel="stylesheet" />

<h3>Gestión de Ausencias</h3>

<!-- 🔹 FILTROS -->
<div class="dashboard-card filtros">

    <input placeholder="Ficha trabajador" @bind="fichaFiltro" />

    <input placeholder="Departamento" @bind="departamentoFiltro" />

    <input placeholder="Cargo" @bind="cargoFiltro" />

    <select @bind="origenFiltro">
        <option value="">Todos</option>
        <option value="NOMINA">Nómina</option>
        <option value="REPOSO">Reposo</option>
    </select>

    <select @bind="tipoFiltro">
        <option value="">Todos</option>
        <option value="AUSENCIA">Ausencia</option>
        <option value="PERMISO">Permiso</option>
        <option value="REPOSO">Reposo</option>
    </select>

    <input type="date" @bind="fechaDesde" />
    <input type="date" @bind="fechaHasta" />

    <button class="btn-filtrar" @onclick="AplicarFiltros">
        Filtrar
    </button>
</div>

<button class="btn btn-primary mb-3" @onclick="Imprimir">
    Imprimir
</button>

@if (resultado == null || !resultado.Any())
{
    <p>Sin resultados.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ficha</th>
                <th>Nombre</th>
                <th>Departamento</th>
                <th>Cargo</th>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Origen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in resultado)
            {
                <tr>
                    <td>@item.Ficha</td>
                    <td>@item.Nombre</td>
                    <td>@item.Departamento</td>
                    <td>@item.Cargo</td>
                    <td>@item.Fecha.ToShortDateString()</td>
                    <td>
                        <span class="@GetClaseTipo(item.Tipo)">
                            @item.Tipo
                        </span>
                    </td>
                    <td>@item.Origen</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // 🔹 DATA
    List<PermisosNomDiariaVDTO> nomina = new();
    List<RepososVDTO> reposos = new();
    List<MaestroTrabajadorDTO> trabajadores = new();

    List<AusenciaDetalleDTO> resultado = new();


    // 🔹 FILTROS
    string? fichaFiltro;
    string? departamentoFiltro;
    string? cargoFiltro;
    string? tipoFiltro;
    string? origenFiltro;

    DateTime? fechaDesde;
    DateTime? fechaHasta;

    protected override async Task OnInitializedAsync()
    {
        nomina = await Api.GetPermisosNomDiaria() ?? new();
        reposos = await Api.GetReposos() ?? new();
        try
        {
            trabajadores = await Api.GetMaestroTrabajadores() ?? new();
        }
        catch
        {
            trabajadores = new List<MaestroTrabajadorDTO>();
        }


        GenerarAusencias();
    }

    void AplicarFiltros()
    {
        GenerarAusencias();
    }

    void GenerarAusencias()
    {
        resultado.Clear();

        // 🔹 NOMINA (FALTAS / PERMISOS)
        foreach (var x in nomina)
        {
            int anio = (int)x.Añohnh;
            int mes = ((int)x.Prdhnh + 1) / 2;

            var fechaBase = new DateTime(anio, mes, 1);

            var dias = new[]
            {
                x.Dg01hh,x.Dg02hh,x.Dg03hh,x.Dg04hh,
                x.Dg05hh,x.Dg06hh,x.Dg07hh
            };

            for (int i = 0; i < dias.Length; i++)
            {
                var d = dias[i];

                if (d != "F" && d != "U") continue;

                var fecha = fechaBase.AddDays(i);

                if (fechaDesde.HasValue && fecha < fechaDesde) continue;
                if (fechaHasta.HasValue && fecha > fechaHasta) continue;

                var t = trabajadores.FirstOrDefault(t => t.Codfic == x.Fichnh);

                resultado.Add(new AusenciaDetalleDTO
                {
                    Ficha = x.Fichnh,
                    Nombre = $"{t?.Nomfi1} {t?.Apefi1}",
                    Departamento = t?.Dptfic ?? "",
                    Cargo = t?.Cgofic ?? "",
                    Fecha = fecha,
                    Tipo = d == "F" ? "AUSENCIA" : "PERMISO",
                    Origen = "NOMINA"
                });
            }
        }

        // 🔹 REPOSOS
        foreach (var r in reposos)
        {
            if (!r.FechaDesde.HasValue) continue;

            var fecha = r.FechaDesde.Value.ToDateTime(TimeOnly.MinValue);

            if (fechaDesde.HasValue && fecha < fechaDesde) continue;
            if (fechaHasta.HasValue && fecha > fechaHasta) continue;

            var t = trabajadores.FirstOrDefault(t => t.Codfic == r.Ficha);

            resultado.Add(new AusenciaDetalleDTO
            {
                Ficha = r.Ficha!,
                Nombre = $"{t?.Nomfi1} {t?.Apefi1}",
                Departamento = t?.Dptfic ?? "",
                Cargo = t?.Cgofic ?? "",
                Fecha = fecha,
                Tipo = "REPOSO",
                Origen = "REPOSO"
            });
        }

        // 🔹 FILTROS FINALES

        if (!string.IsNullOrEmpty(fichaFiltro))
            resultado = resultado.Where(x => x.Ficha.Contains(fichaFiltro)).ToList();

        if (!string.IsNullOrEmpty(departamentoFiltro))
            resultado = resultado.Where(x => x.Departamento.Contains(departamentoFiltro)).ToList();

        if (!string.IsNullOrEmpty(cargoFiltro))
            resultado = resultado.Where(x => x.Cargo.Contains(cargoFiltro)).ToList();

        if (!string.IsNullOrEmpty(tipoFiltro))
            resultado = resultado.Where(x => x.Tipo == tipoFiltro).ToList();

        if (!string.IsNullOrEmpty(origenFiltro))
            resultado = resultado.Where(x => x.Origen == origenFiltro).ToList();
    }

    string GetClaseTipo(string tipo)
    {
        return tipo switch
        {
            "AUSENCIA" => "tipo-ausencia",
            "PERMISO" => "tipo-permiso",
            "REPOSO" => "tipo-reposo",
            _ => ""
        };
    }

    async Task Imprimir()
    {
        await JS.InvokeVoidAsync("imprimirElemento");
    }

    public class AusenciaDetalleDTO
    {
        public string Ficha { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Departamento { get; set; } = "";
        public string Cargo { get; set; } = "";
        public DateTime Fecha { get; set; }
        public string Tipo { get; set; } = "";
        public string Origen { get; set; } = "";
    }
}