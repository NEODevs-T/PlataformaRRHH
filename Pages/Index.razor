@page "/"

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Inicio</PageTitle>

<div class="dashboard-container">

    <!-- HEADER -->
    <div class="dashboard-header">
        NEO RRHH
    </div>

    <!-- KPI CARDS -->
    <div class="cards-container">

        <div class="card">
            <h5>Total Empleados</h5>
            <span>128</span>
        </div>

        <div class="card">
            <h5>Ausencias Hoy</h5>
            <span>12</span>
        </div>

        <div class="card">
            <h5>Departamentos</h5>
            <span>8</span>
        </div>

    </div>

    <!-- CARD INFO -->
    <div class="dashboard-info-card">

        <div class="dashboard-title">
            Gestión Inteligente de Recursos Humanos
        </div>

        <p class="dashboard-subtitle">
            Plataforma centralizada para la gestión de personal, control de ausencias y análisis de información estratégica.
        </p>

    </div>

    <!-- CARD PRINCIPAL -->
    <div class="dashboard-card">

        <div class="dashboard-section">

            <div class="dashboard-box">
                <h3>Neo RRHH</h3>
                <p>
                    Simplificar la gestión del talento humano mediante una plataforma eficiente
                    que permita registrar, procesar y analizar información crítica de manera confiable,
                    apoyando la toma de decisiones y optimizando los procesos organizacionales.
                </p>
            </div>

        </div>

    </div>

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();

        if (!auth.User.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login", true);
            return;
        }
    }
}