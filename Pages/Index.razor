@page "/"

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider


<link href="./css/site.css" rel="stylesheet" />

<PageTitle>Inicio</PageTitle>


<div class="dashboard-container">

    <!-- HEADER -->
    <div class="dashboard-header">
        NEO RRHH
    </div>

    
    <!-- CARD INFORMACIÓN -->
    <div class="dashboard-info-card">

        <div class="dashboard-title">
            Gestión Inteligente de Recursos Humanos
        </div>

        <p class="dashboard-subtitle">
            Plataforma centralizada para la gestión de personal, control de ausencias y análisis de información estratégica.
        </p>

    </div>

    <!-- CARD PRINCIPAL -->
    <div class="dashboard-card">

        <div class="dashboard-section">

            <!-- MISIÓN -->
            <div class="dashboard-box">
                <h3>Neo RRHH:</h3>
                <p>
                    Simplificar la gestión del talento humano mediante una plataforma eficiente
                    que permita registrar, procesar y analizar información crítica de manera confiable,
                    apoyando la toma de decisiones y optimizando los procesos organizacionales.
                </p>
            </div>

        </div>

    </div>

</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var auth =
                await AuthStateProvider
                    .GetAuthenticationStateAsync();

            var user = auth.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                Nav.NavigateTo("/login");
            }
        }
    }
}