@page "/login"
@layout NeoRH.Shared.EmptyLayout

@using NeoRH.DTOs
@using NeoRH.Services
@using Blazored.LocalStorage

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

@attribute [AllowAnonymous]

<link href="./css/site.css" rel="stylesheet" />

<div class="login-wrapper">

    <div class="login-card">

        <img src="/img/Neo.png" class="login-logo" />

        <h1>Neo RH</h1>

        <div class="login-form">

            <!-- USUARIO -->
            <div class="input-container @(usuarioValido ? "input-ok" : "")">
                <input placeholder="Usuario" @bind="user.UserName" />

                @if (usuarioValido)
                {
                    <span class="check">✔</span>
                }
            </div>

            @if (usuarioValido)
            {
                <small class="text-ok">Correcto.</small>
            }

            <!-- PASSWORD -->
            <div class="input-container @(claveValida ? "input-ok" : "")">
                <input type="password" placeholder="Contraseña" @bind="user.Password" />

                @if (claveValida)
                {
                    <span class="check">✔</span>
                }
            </div>

            @if (claveValida)
            {
                <small class="text-ok">Correcto.</small>
            }

            <button type="button" @onclick="HandleLogin">
                Iniciar Sesión
            </button>
        </div>

        <div class="login-footer">
            Neo @DateTime.Now.Year
        </div>

        <p>@mensaje</p>

    </div>
</div>

@code {

    UserLoginDto user = new();

    string mensaje = "";

    bool usuarioValido = false;
    bool claveValida = false;

    async Task HandleLogin()
    {
        try
        {
            usuarioValido = false;
            claveValida = false;
            mensaje = "";

            if (string.IsNullOrWhiteSpace(user.UserName))
            {
                mensaje = "Debe ingresar el usuario";
                return;
            }

            if (string.IsNullOrWhiteSpace(user.Password))
            {
                mensaje = "Debe ingresar la contraseña";
                return;
            }

            mensaje = "Validando...";

            // 🚫 YA NO USAMOS PROYECTO
            // user.Proyecto = "PlataformaRH";

            var result = await Http.PostAsJsonAsync(
                "http://neo.paveca.com.ve/Authentication/api/Auth/Login",
                user);

            var response = await result.Content.ReadAsStringAsync();

            if (string.IsNullOrWhiteSpace(response))
            {
                mensaje = "Servidor sin respuesta";
                return;
            }

            var token = response.Trim('"');

            // ✅ ERRORES
            if (token == "NotFoundUser")
            {
                mensaje = "Usuario no encontrado";
                return;
            }

            if (token == "WrongPassword")
            {
                mensaje = "Contraseña incorrecta";
                return;
            }

            if (token == "UserInactive")
            {
                mensaje = "Usuario inactivo";
                return;
            }

            // ✅ LOGIN OK
            usuarioValido = true;
            claveValida = true;

            mensaje = "Acceso válido";

            // ✅ USAR TU PROVIDER (CORRECTO)
            await ((CustomAuthStateProvider)AuthStateProvider).Login(token);

            Nav.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            mensaje = "Error: " + ex.Message;
        }
    }
}