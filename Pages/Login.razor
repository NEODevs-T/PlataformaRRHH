@page "/login"

@using NeoRH.DTOs
@using NeoRH.Services
@using System.Globalization

@inject HttpClient Http
@inject CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav

@attribute [AllowAnonymous]

<div class="login-wrapper">

    <!-- 🌐 IDIOMA EN ESQUINA -->
    <div class="idioma-box">
        <select @bind="idioma">
            <option value="es">ES</option>
            <option value="en">EN</option>
        </select>
    </div>

    <div class="login-card fade-in">

        <img src="/img/Neo.png" class="login-logo" />

        <h1>Neo RH</h1>

        <div class="login-form">

            <!-- USER -->
            <div class="input-container">
                <input placeholder="Usuario"
                    @bind="user.UserName" />
            </div>

            <!-- PASSWORD -->
            <div class="input-container">
                <input type="password"
                    placeholder="Contraseña"
                    @bind="user.Password" />
            </div>

            <!-- BUTTON -->
            <button @onclick="HandleLogin" disabled="@loading">
                @(loading ? Texto("loading") : Texto("login"))
            </button>

        </div>

        <p class="login-message">@_message</p>

        <div class="login-footer">
            Neo @DateTime.Now.Year
        </div>

    </div>
</div>

@code {

    private string _message = "";
    private bool loading = false;
    private string idioma = "es";

    UserLoginDto user = new();

    async Task HandleLogin()
    {
        try
        {
            _message = "";
            loading = true;

            // ✅ CULTURA
            var culture = new CultureInfo(idioma);
            CultureInfo.DefaultThreadCurrentCulture = culture;
            CultureInfo.DefaultThreadCurrentUICulture = culture;

            // ✅ VALIDACIÓN CAMPOS
            if (string.IsNullOrWhiteSpace(user.UserName) ||
                string.IsNullOrWhiteSpace(user.Password))
            {
                _message = Texto("invalid");
                return;
            }

            // ✅ PROYECTO CORRECTO (NO TOCAR)
            user.Proyecto = "PlataformaRH";

            var result = await Http.PostAsJsonAsync(
                "http://operaciones.papeleslatinos.com/AuthenticationP/api/Auth/Login",
                user);

            // ✅ VALIDACIÓN HTTP
            if (!result.IsSuccessStatusCode)
            {
                _message = "Error en servidor";
                return;
            }

            Console.WriteLine($"STATUS: {result.StatusCode}");

            var response = await result.Content.ReadAsStringAsync();

            Console.WriteLine($"API RAW: {response}");

            if (string.IsNullOrWhiteSpace(response))
            {
                _message = Texto("noresponse");
                return;
            }

            // ✅ LIMPIEZA SEGURA
            var token = response.Trim().Replace("\"", "");

            Console.WriteLine($"TOKEN LIMPIO: {token}");

            // ✅ VALIDACIONES BACKEND
            if (token == "NotFoundUser")
            {
                _message = Texto("usernotfound");
                return;
            }

            if (token == "WrongPassword")
            {
                _message = Texto("wrongpassword");
                return;
            }

            if (token.Equals("null", StringComparison.OrdinalIgnoreCase))
            {
                _message = Texto("noaccess");
                return;
            }

            // ✅ VALIDACIÓN JWT
            if (!token.Contains("."))
            {
                _message = Texto("invalid");
                return;
            }

            // ✅ LOGIN OK
            await AuthProvider.Login(token);

            _message = Texto("success");

            Nav.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            _message = "Error";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    // ✅ TEXTOS MULTIIDIOMA
    string Texto(string clave)
    {
        return (idioma, clave) switch
        {
            ("es", "login") => "Iniciar",
            ("en", "login") => "Login",

            ("es", "loading") => "Ingresando...",
            ("en", "loading") => "Signing in...",

            ("es", "usernotfound") => "Usuario no encontrado",
            ("en", "usernotfound") => "User not found",

            ("es", "wrongpassword") => "Contraseña incorrecta",
            ("en", "wrongpassword") => "Wrong password",

            ("es", "noaccess") => "Sin acceso",
            ("en", "noaccess") => "No access",

            ("es", "invalid") => "Credenciales inválidas",
            ("en", "invalid") => "Invalid credentials",

            ("es", "noresponse") => "Servidor sin respuesta",
            ("en", "noresponse") => "No server response",

            ("es", "success") => "Acceso válido",
            ("en", "success") => "Access granted",

            _ => "..."
        };
    }
}