@page "/historico"

@using NeoRH.DTOs
@using NeoRH.ViewModels

@inject IRRHHApiService Api

<link href="./css/site.css" rel="stylesheet" />

<h2 class="page-title">Histórico de Ausencias</h2>

@if (ausenciasFiltradas == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="headcount-container">

        <!-- FILTROS -->
        <div class="filtro-container">

            <input type="number"
                   placeholder="Año"
                   @bind="filtroAnio"
                   class="input" />

            <input placeholder="Ficha..."
                   @bind="filtroFicha"
                   class="input" />

            <select @bind="filtroTipo" class="input">
                <option value="">Todos</option>
                <option value="P">Permiso</option>
                <option value="R">Reposo</option>
            </select>

            <button class="btn" @onclick="AplicarFiltros">
                Filtrar
            </button>

        </div>

        <!-- TABLA -->
        <table class="table-custom">

            <thead>
                <tr>
                    <th>Ficha</th>
                    <th>Nombre</th>
                    <th>Departamento</th>
                    <th>Cargo</th>
                    <th>Tipo</th>
                    <th>Año</th>
                    <th>Fecha</th>
                </tr>
            </thead>

            <tbody>

                @if (!ausenciasFiltradas.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center">
                            No existen registros.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in ausenciasFiltradas)
                    {
                        <tr>
                            <td>@item.Ficha</td>
                            <td>@item.Nombre</td>
                            <td>@item.Departamento</td>
                            <td>@item.Cargo</td>
                            <td>
                                @(item.Tipo == "P"
                                    ? "Permiso"
                                    : item.Tipo == "R"
                                        ? "Reposo"
                                        : item.Tipo)
                            </td>
                            <td>@item.Año</td>
                            <td>@FormatearFecha(item.Fecha)</td>
                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>
}

@code {

    List<MaestroTrabajadorDTO> empleados = new();

    List<AusenciaViewModel> ausenciasCombinadas = new();
    List<AusenciaViewModel> ausenciasFiltradas = new();

    int? filtroAnio;
    string filtroFicha = "";
    string filtroTipo = "";

    protected override async Task OnInitializedAsync()
    {
        empleados = await Api.GetMaestroTrabajadores();

        CombinarDatos();

        ausenciasFiltradas = ausenciasCombinadas
            .OrderByDescending(x => x.Año)
            .ThenByDescending(x => x.Fecha)
            .ToList();
    }

    private void CombinarDatos()
    {
        ausenciasCombinadas = new List<AusenciaViewModel>();

        // Aquí posteriormente se agregarán:
        // Permisos
        // Reposos
        // Ausencias provenientes de SPI o MyIntelli

        /*
        ausenciasCombinadas.Add(new AusenciaViewModel
        {
            Ficha = "12345",
            Nombre = "Juan Pérez",
            Departamento = "Producción",
            Cargo = "Operador",
            Tipo = "P",
            Año = 2025,
            Fecha = DateTime.Now.ToString("yyyy-MM-dd")
        });
        */
    }

    private void AplicarFiltros()
    {
        IEnumerable<AusenciaViewModel> query = ausenciasCombinadas;

        if (filtroAnio.HasValue)
        {
            query = query.Where(x => x.Año == filtroAnio.Value);
        }

        if (!string.IsNullOrWhiteSpace(filtroFicha))
        {
            query = query.Where(x =>
                !string.IsNullOrWhiteSpace(x.Ficha) &&
                x.Ficha.Contains(
                    filtroFicha,
                    StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(filtroTipo))
        {
            query = query.Where(x => x.Tipo == filtroTipo);
        }

        ausenciasFiltradas = query
            .OrderByDescending(x => x.Año)
            .ThenByDescending(x => x.Fecha)
            .ToList();

        StateHasChanged();
    }

    private string FormatearFecha(string? fecha)
    {
        if (string.IsNullOrWhiteSpace(fecha))
            return "";

        if (DateTime.TryParse(fecha, out var fechaConvertida))
            return fechaConvertida.ToString("dd/MM/yyyy");

        return fecha;
    }

    public class AusenciaViewModel
    {
        public string? Ficha { get; set; }

        public string? Nombre { get; set; }

        public string? Departamento { get; set; }

        public string? Cargo { get; set; }

        public string? Tipo { get; set; } // P = Permiso, R = Reposo

        public int Año { get; set; }

        public string? Fecha { get; set; }

        public string? Origen { get; set; }
    }

}

