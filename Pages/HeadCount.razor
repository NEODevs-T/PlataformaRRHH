@page "/headcount"

@using NeoRH.DTOs

@inject IRRHHApiService Api

<link href="./css/site.css" rel="stylesheet" />

<h2 class="page-title">HeadCount Organizacional</h2>

@if (empleados == null || !empleados.Any())
{
    <p>Cargando...</p>
}
else
{
    <div class="headcount-container">

        <!-- FILTROS -->
        <div class="filtro-container">

            <input
                placeholder="Buscar empleado..."
                @bind="filtroTexto"
                class="input" />

            <select @bind="departamentoFiltro" class="input">
                <option value="">Todos los departamentos</option>

                @foreach (var dep in listaDepartamentos)
                {
                    <option value="@dep">@dep</option>
                }
            </select>

            <select @bind="cargoFiltro" class="input">
                <option value="">Todos los cargos</option>

                @foreach (var cargo in listaCargos)
                {
                    <option value="@cargo">@cargo</option>
                }
            </select>

            <button class="btn" @onclick="AplicarFiltro">
                Filtrar
            </button>

        </div>

        <!-- KPI -->
        <div class="headcount-cards">

            <div class="headcount-card">
                <h5>Total Empleados</h5>
                <span>@total</span>
            </div>

            <div class="headcount-card">
                <h5>Departamentos</h5>
                <span>@totalDepartamentos</span>
            </div>

            <div class="headcount-card">
                <h5>Cargos</h5>
                <span>@totalCargos</span>
            </div>

            <div class="headcount-card">
                <h5>Mayor Dotación</h5>
                <span>@departamentoMayor</span>
            </div>

        </div>

        <!-- GRAFICO -->
        <h4 style="margin-top:25px">
            Distribución por Departamento
        </h4>

        <div class="grafico-container">

            @foreach (var item in headcountPorDepartamento)
            {
                <div class="barra-container">

                    <div class="barra"
                         style="height:@(item.Cantidad * 4)px;">
                    </div>

                    <span>@item.Departamento</span>

                    <small>
                        @item.Cantidad
                        (@item.Porcentaje%)
                    </small>

                </div>
            }

        </div>

        <!-- TABLA RESUMEN -->

        <table class="table-custom">

            <thead>

                <tr>
                    <th>#</th>
                    <th>Departamento</th>
                    <th>Cantidad</th>
                    <th>% HeadCount</th>
                </tr>

            </thead>

            <tbody>

                @{
                    int contador = 1;
                }

                @foreach (var item in resumen)
                {
                    <tr>

                        <td>@contador</td>

                        <td>@item.Departamento</td>

                        <td>@item.Cantidad</td>

                        <td>@item.Porcentaje%</td>

                    </tr>

                    contador++;
                }

            </tbody>

            <tfoot>

                <tr style="font-weight:bold">

                    <td colspan="2">
                        TOTAL
                    </td>

                    <td>@total</td>

                    <td>100%</td>

                </tr>

            </tfoot>

        </table>

    </div>
}

@code {

    List<MaestroTrabajadorDTO> empleados = new();
    List<MaestroTrabajadorDTO> empleadosFiltrados = new();

    string filtroTexto = "";
    string departamentoFiltro = "";
    string cargoFiltro = "";

    List<string?> listaDepartamentos = new();
    List<string?> listaCargos = new();

    List<HeadCountViewModel> resumen = new();
    List<HeadCountViewModel> headcountPorDepartamento = new();

    int total = 0;
    int totalDepartamentos = 0;
    int totalCargos = 0;

    string departamentoMayor = "";

    protected override async Task OnInitializedAsync()
    {
        empleados = await Api.GetMaestroTrabajadores();

        empleadosFiltrados = empleados;

        listaDepartamentos = empleados
            .Select(x => x.Dptfic)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        listaCargos = empleados
            .Select(x => x.Cgofic)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        AgruparDatos();
        CalcularIndicadores();
    }

    private void AplicarFiltro()
    {
        IEnumerable<MaestroTrabajadorDTO> query = empleados;

        if (!string.IsNullOrWhiteSpace(filtroTexto))
        {
            query = query.Where(e =>
                (!string.IsNullOrWhiteSpace(e.Codfic) &&
                 e.Codfic.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(e.Nomfi1) &&
                 e.Nomfi1.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase))
                ||
                (!string.IsNullOrWhiteSpace(e.Apefi1) &&
                 e.Apefi1.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrWhiteSpace(departamentoFiltro))
        {
            query = query.Where(x => x.Dptfic == departamentoFiltro);
        }

        if (!string.IsNullOrWhiteSpace(cargoFiltro))
        {
            query = query.Where(x => x.Cgofic == cargoFiltro);
        }

        empleadosFiltrados = query.ToList();

        AgruparDatos();
        CalcularIndicadores();

        StateHasChanged();
    }

    private void AgruparDatos()
    {
        total = empleadosFiltrados.Count;

        headcountPorDepartamento = empleadosFiltrados
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Dptfic)
                ? "SIN DEPARTAMENTO"
                : x.Dptfic)
            .Select(g => new HeadCountViewModel
            {
                Departamento = g.Key,
                Cantidad = g.Count(),
                Porcentaje = total > 0
                    ? Math.Round((decimal)g.Count() * 100 / total, 2)
                    : 0
            })
            .OrderByDescending(x => x.Cantidad)
            .Take(10)
            .ToList();

        resumen = headcountPorDepartamento;

        departamentoMayor = headcountPorDepartamento.Any()
            ? headcountPorDepartamento.First().Departamento
            : "";
    }

    private void CalcularIndicadores()
    {
        totalDepartamentos = empleadosFiltrados
            .Select(x => x.Dptfic)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .Count();

        totalCargos = empleadosFiltrados
            .Select(x => x.Cgofic)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .Count();
    }

    public class HeadCountViewModel
    {
        public string Departamento { get; set; } = "";

        public int Cantidad { get; set; }

        public decimal Porcentaje { get; set; }
    }

}
