@namespace NeoRH.Shared
@inherits LayoutComponentBase

@using NeoRH.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject CustomAuthStateProvider AuthProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="layout-container">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <!-- MAIN -->
    <div class="main-wrapper">

        <!-- TOPBAR -->
        <div class="topbar">

            <span class="title">
                Neo RH
            </span>

            <!-- ✅ USER INFO -->
            <AuthorizeView>
                <Authorized Context="auth">

                    <div class="user-info">

                        <span class="user-name">
                            👤 @GetNombre(auth.User)
                        </span>

                        <span class="user-role">
                            🔐 @GetRol(auth.User)
                        </span>

                        <button class="btn-logout"
                                @onclick="CerrarSesion">
                            Cerrar sesión
                        </button>

                    </div>

                </Authorized>
            </AuthorizeView>

        </div>

        <!-- CONTENT -->
        <main class="main-content">
            @Body
        </main>

    </div>

</div>

@code {

    async Task CerrarSesion()
    {
        await AuthProvider.Logout();

        Nav.NavigateTo("/login");
    }

    // ✅ HELPERS LIMPIOS
    string GetNombre(ClaimsPrincipal user)
    {
        return CustomAuthStateProvider.GetUserName(user);
    }

    string GetRol(ClaimsPrincipal user)
    {
        return CustomAuthStateProvider.GetUserRole(user);
    }
}