@namespace NeoRH.Shared

@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<div class="sidebar-menu">

    <!-- HEADER -->
    <div class="sidebar-header">
        <img src="/img/Neo.png" class="sidebar-logo" />
        <span class="sidebar-title">Neo RRHH</span>
    </div>

    <!-- MENU -->
    <div class="menu">

        <!-- INICIO -->
        <NavLink href="/"
                class="nav-item"
                Match="NavLinkMatch.All">
            <i class="oi oi-home"></i>
            <span>Inicio</span>
        </NavLink>

        <!-- INDICADORES -->
        <NavLink href="/indicadores"
                class="nav-item">
            <i class="oi oi-bar-chart"></i>
            <span>Indicadores</span>
        </NavLink>

        <!-- AUSENCIAS -->
        <NavLink href="/ausencias"
                class="nav-item">
            <i class="oi oi-calendar"></i>
            <span>Ausencias</span>
        </NavLink>

        <!-- HISTORICO -->
        <NavLink href="/historico"
                class="nav-item">
            <i class="oi oi-clock"></i>
            <span>Histórico</span>
        </NavLink>

        <!-- HEADCOUNT -->
        <NavLink href="/headcount"
                class="nav-item">
            <i class="oi oi-people"></i>
            <span>HeadCount</span>
        </NavLink>

        <!-- PERMISOS -->
        <NavLink href="/permisos"
                class="nav-item">
            <i class="oi oi-key"></i>
            <span>Permisos</span>
        </NavLink>

        <!-- REPOSOS -->
        <NavLink href="/reposos"
                class="nav-item">
            <i class="oi oi-heart"></i>
            <span>Reposos</span>
        </NavLink>

    </div>

</div>