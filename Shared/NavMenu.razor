@namespace NeoRH.Shared

@using NeoRH.Services
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<div class="menu">

    <!-- HEADER -->
    <div class="sidebar-header">
        <img src="img/Neo.png" class="sidebar-logo" />
        <span class="sidebar-title">Neo RRHH</span>
    </div>

    <!-- MENU -->
    <AuthorizeView>
        <Authorized Context="auth">

            @{
                var rol = CustomAuthStateProvider.GetUserRole(auth.User);

                bool esAdmin =
                    rol == "Admin" ||
                    rol == "SuperAdmin";

                bool esRRHH =
                    rol == "Gerente_RRHH" ||
                    rol == "SuperUser";

                bool esFinanzas =
                    rol == "Gerente_Finanzas";

                bool esSalud =
                    rol == "Gerente_Salud";
            }

        <!-- INICIO -->
        <NavLink href=""
                class="nav-item"
                Match="NavLinkMatch.All">
            <i class="oi oi-home"></i>
            <span>Inicio</span>
        </NavLink>

        @if (esAdmin || esRRHH)
        {
        <!-- INDICADORES -->
        <NavLink href="indicadores"
                class="nav-item">
            <i class="oi oi-bar-chart"></i>
            <span>Indicadores</span>
        </NavLink>

        }

        @if (esAdmin || esRRHH || esFinanzas || esSalud)
        {

        <!-- AUSENCIAS -->
        <NavLink href="ausencias"
                class="nav-item">
            <i class="oi oi-calendar"></i>
            <span>Ausencias</span>
        </NavLink>

        }
        @if (esAdmin || esRRHH || esFinanzas)
        {

        <NavLink href="RegistroNomina"
            class="nav-item">
            <i class="oi oi-document"></i>
            <span>Registro Nómina</span>
        </NavLink>

        }

        @if (esAdmin)
        {
        <!-- HISTORICO -->
        <NavLink href="historico"
                class="nav-item">
            <i class="oi oi-clock"></i>
            <span>Histórico</span>
        </NavLink>

        <!-- HEADCOUNT -->
        <NavLink href="headcount"
                class="nav-item">
            <i class="oi oi-people"></i>
            <span>HeadCount</span>
        </NavLink>

        <!-- ROTACION -->
        <NavLink href="rotacion" class="nav-item">
            <i class="oi oi-random"></i>
            <span>Rotación</span>
        </NavLink>
        }
                </Authorized>
    </AuthorizeView>

</div>